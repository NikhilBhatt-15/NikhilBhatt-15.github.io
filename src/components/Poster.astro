---
// A generated one-sheet movie poster for a product. Pure SVG, so it is sharp at any size.
interface Props {
  name: string;
  kind?: string;
  tagline: string;
  platform: string;
  language: string;
  genre: string;
  poster: { bg: string; ink: string; accent: string; motif: string };
  requires?: string; // runtime the product needs, e.g. "Python + Ollama"
  version?: string;
  status?: string; // e.g. "NOW SHOWING" / "COMING SOON"
  class?: string;
}
const { name, kind = 'download', tagline, platform, language, genre, poster, requires, version, status = 'NOW SHOWING', class: cls } = Astro.props;
const { bg, ink, accent, motif } = poster;
const id = name.toLowerCase().replace(/[^a-z0-9]/g, '');
const big = name.toUpperCase();
// Rough advance widths (em) for Inter Tight 800 caps, so long names shrink to fit 352px.
const em = [...big].reduce((s, c) => s + (/[MW]/.test(c) ? 0.9 : /[IJ1]/.test(c) ? 0.3 : /[LTFEPSZ]/.test(c) ? 0.62 : /[ \-]/.test(c) ? 0.28 : 0.72) - 0.03, 0);
const nameSize = Math.min(118, Math.floor(344 / em));
const titleY = 512;
const taglineY = titleY - nameSize * 0.74 - 16;
const tail =
  kind === 'web' ? 'NOW PLAYING ONLINE · FREE ADMISSION'
  : kind === 'self-host' ? `RUNS ON ${platform.toUpperCase()}`
  : kind === 'coming-soon' ? 'IN DEVELOPMENT'
  : `${requires ? `REQUIRES ${requires.toUpperCase()}` : 'NO RUNTIME REQUIRED'} · ${version ? `RELEASE ${version.toUpperCase()}` : 'IN DEVELOPMENT'}`;
const billing = `A NIKHIL BHATT PRODUCTION · WRITTEN IN ${language.toUpperCase()} · ${genre.toUpperCase()} · ${tail}`;
const seats = Array.from({ length: 7 * 9 }, (_, i) => ({ r: Math.floor(i / 9), c: i % 9 }));
const picked = new Set([30, 31, 32]);
// "seek": an editor page of code lines (indent, width); line 7 is the match.
const codeLines = [
  [0, 150], [24, 210], [24, 120], [48, 180], [0, 0], [0, 170], [24, 230],
  [24, 200], [48, 140], [24, 90], [0, 0], [0, 190],
].map(([indent, w]) => ({ x: 72 + indent, w }));
---

<svg class:list={['poster', cls]} viewBox="0 0 400 600" role="img" aria-label={`${name} poster: ${tagline}`}>
  <defs>
    <radialGradient id={`glow-${id}`} cx="50%" cy="38%" r="60%">
      <stop offset="0" stop-color={accent} stop-opacity="0.38"></stop>
      <stop offset="1" stop-color={accent} stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id={`fade-${id}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0.45" stop-color={bg} stop-opacity="0"></stop>
      <stop offset="0.82" stop-color={bg} stop-opacity="1"></stop>
    </linearGradient>
    <filter id={`n-${id}`}>
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"></feTurbulence>
      <feColorMatrix values="0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0.35 0"></feColorMatrix>
      <feComposite operator="in" in2="SourceGraphic"></feComposite>
    </filter>
  </defs>

  <rect width="400" height="600" fill={bg}></rect>
  <rect width="400" height="600" fill={`url(#glow-${id})`}></rect>

  <g class="motif" fill="none" stroke={ink} stroke-linecap="round" stroke-linejoin="round">
    {
      motif === 'stack' && (
        <g>
          {[0, 1, 2, 3].map((i) => (
            <g transform={`translate(${118 + i * 10} ${70 + i * 34}) rotate(${-9 + i * 5} 82 60)`}>
              <rect width="164" height="118" rx="12" fill={i === 3 ? accent : bg} stroke={i === 3 ? accent : ink} stroke-opacity={0.25 + i * 0.2} stroke-width="2" />
              {[0, 1, 2].map((l) => (
                <rect x="18" y={26 + l * 24} width={l === 2 ? 70 : 128} height="8" rx="4" fill={i === 3 ? bg : ink} fill-opacity={i === 3 ? 0.8 : 0.18} stroke="none" />
              ))}
            </g>
          ))}
        </g>
      )
    }
    {
      motif === 'lens' && (
        <g>
          {[150, 118, 86].map((r, i) => (
            <circle cx="190" cy="196" r={r} stroke-opacity={0.12 + i * 0.12} stroke-width="1.5" />
          ))}
          <circle cx="190" cy="196" r="70" stroke={accent} stroke-width="14" />
          <circle cx="190" cy="196" r="56" fill={accent} fill-opacity="0.12" stroke="none" />
          <path d="M240 246 L300 306" stroke={accent} stroke-width="22" />
          <path d="M160 170 a40 40 0 0 1 34 -16" stroke={ink} stroke-width="6" stroke-opacity="0.8" />
        </g>
      )
    }
    {
      motif === 'seek' && (
        <g>
          {codeLines.map(({ x, w }, i) => (
            <rect x={x} y={64 + i * 24} width={w} height="9" rx="4.5" fill={i === 7 ? accent : ink} fill-opacity={i === 7 ? 1 : 0.16} stroke="none" />
          ))}
          <circle cx="226" cy="236" r="66" fill={bg} fill-opacity="0.35" stroke={accent} stroke-width="12" />
          <path d="M273 283 L326 336" stroke={accent} stroke-width="20" />
          <path d="M196 206 a38 38 0 0 1 30 -12" stroke={ink} stroke-width="5" stroke-opacity="0.7" />
        </g>
      )
    }
    {
      motif === 'nib' && (
        <g transform="translate(200 210) rotate(-28)">
          <path d="M0 -150 C 58 -88 70 -24 46 52 L 18 96 L 0 150 L -18 96 L -46 52 C -70 -24 -58 -88 0 -150 Z" fill={ink} stroke="none" />
          <path d="M0 -10 L0 150" stroke={bg} stroke-width="4" />
          <circle cx="0" cy="-22" r="14" fill={bg} stroke="none" />
          <path d="M-46 52 L46 52" stroke={bg} stroke-width="3" stroke-opacity="0.6" />
          <path d="M0 150 C 30 190 80 200 130 186" stroke={accent} stroke-width="6" />
        </g>
      )
    }
    {
      motif === 'runner' && (
        <g>
          <polyline
            points="20,330 60,322 90,326 120,300 150,312 180,268 210,284 240,236 270,252 300,206 330,224 380,182"
            stroke={accent}
            stroke-width="5"
          />
          <polyline points="20,330 60,322 90,326 120,300 150,312 180,268 210,284 240,236 270,252 300,206 330,224 380,182 380,600 20,600" fill={accent} fill-opacity="0.08" stroke="none" />
          <g transform="translate(118 108) scale(9)" fill={ink} stroke="none">
            <path d="M2 6h1V5h1V4h1v1h1v1h6V5h1V4h1v1h1v1h1v3h-1v1h-1v1h-1v2h1v1h-2v-1h-1v-2H7v2h1v1H6v-1H5v-2H4v-1H3V9H1V8h1z" />
            <rect x="13" y="7" width="1" height="1" fill={bg} />
          </g>
        </g>
      )
    }
    {
      motif === 'seats' && (
        <g>
          <path d="M70 90 Q200 60 330 90" stroke={accent} stroke-width="5" />
          <text x="200" y="118" fill={ink} fill-opacity="0.5" stroke="none" style="font-family:var(--mono)" font-size="9" text-anchor="middle" letter-spacing="3">SCREEN THIS WAY</text>
          {seats.map(({ r, c }, i) => (
            <rect
              x={88 + c * 26 + (c > 3 ? 10 : 0)}
              y={146 + r * 26}
              width="18"
              height="16"
              rx="4"
              fill={picked.has(i) ? accent : i % 7 === 2 || i % 11 === 0 ? ink : 'none'}
              fill-opacity={picked.has(i) ? 1 : 0.22}
              stroke={picked.has(i) ? accent : ink}
              stroke-opacity={picked.has(i) ? 1 : 0.4}
              stroke-width="1.5"
            />
          ))}
        </g>
      )
    }
    {
      motif === 'jet' && (
        <g>
          {[0, 1, 2, 3, 4].map((i) => (
            <path d={`M${40 + i * 16} ${420 - i * 6} C ${140 + i * 10} ${330 - i * 20}, ${200} ${220}, ${300 - i * 4} ${110 + i * 6}`} stroke={i === 2 ? accent : ink} stroke-opacity={i === 2 ? 1 : 0.18} stroke-width={i === 2 ? 6 : 2} />
          ))}
          <circle cx="300" cy="118" r="34" stroke={accent} stroke-width="3" />
          <path d="M300 70 V100 M300 136 V166 M252 118 H282 M318 118 H348" stroke={accent} stroke-width="3" />
          <circle cx="300" cy="118" r="5" fill={accent} stroke="none" />
        </g>
      )
    }
    {
      motif === 'hop' && (
        <g>
          {[0, 1, 2].map((r) => [0, 1, 2].map((c) => (
            <rect x={196 + c * 50} y={64 + r * 50} width="38" height="38" rx="10" fill={r === 1 && c === 0 ? accent : ink} fill-opacity={r === 1 && c === 0 ? 1 : 0.14} stroke="none" />
          )))}
          <path d="M92 318 Q 122 236 152 296" stroke={ink} stroke-opacity="0.35" stroke-width="5" stroke-dasharray="2 12" />
          <path d="M152 296 Q 150 160 186 136" stroke={accent} stroke-width="6" stroke-dasharray="2 14" />
          <circle cx="152" cy="296" r="6" fill={ink} fill-opacity="0.5" stroke="none" />
          <rect x="44" y="322" width="96" height="84" rx="16" fill={bg} stroke={ink} stroke-opacity="0.85" stroke-width="5" />
          <path d="M60 390 H124" stroke={ink} stroke-opacity="0.25" stroke-width="5" />
          <path d="M84 344 L98 362" stroke={accent} stroke-width="9" />
        </g>
      )
    }
    {
      motif === 'cadence' && (
        <g>
          {[70, 120, 95, 170, 140, 215, 270].map((h, i) => (
            <rect x={62 + i * 42} y={350 - h} width="26" height={h} rx="13" fill={i === 6 ? accent : ink} fill-opacity={i === 6 ? 1 : 0.14 + i * 0.05} stroke="none" />
          ))}
          <path d="M60 366 H340" stroke={ink} stroke-opacity="0.3" stroke-width="2" stroke-dasharray="1 9" />
          <path d="M222 60 V366" stroke="#ff7a2f" stroke-width="3" />
          <circle cx="222" cy="60" r="9" fill="#ff7a2f" stroke="none" />
          <circle cx="222" cy="60" r="18" fill="#ff7a2f" fill-opacity="0.2" stroke="none" />
          <g transform="translate(92 110)">
            <rect width="88" height="48" rx="10" fill={ink} stroke="none" />
            <rect x="12" y="13" width="56" height="6" rx="3" fill={bg} fill-opacity="0.75" stroke="none" />
            <rect x="12" y="27" width="38" height="6" rx="3" fill={bg} fill-opacity="0.4" stroke="none" />
            <path d="M24 48 l-4 12 l14 -12 z" fill={ink} stroke="none" />
          </g>
        </g>
      )
    }
    {
      motif === 'tag' && (
        <g>
          <path d="M120 60 C 150 20, 250 20, 262 86" stroke={ink} stroke-opacity="0.5" stroke-width="2.5" />
          <g transform="rotate(-12 200 200)">
            <path d="M120 100 H 300 a10 10 0 0 1 10 10 V 290 a10 10 0 0 1 -10 10 H 120 L 80 200 Z" fill={ink} stroke="none" />
            <circle cx="112" cy="200" r="11" fill={bg} stroke="none" />
            <text x="215" y="178" fill={bg} fill-opacity="0.45" text-anchor="middle" font-size="40" font-weight="800" style="font-family:var(--display)">₹1,200</text>
            <path d="M150 166 L 282 166" stroke={accent} stroke-width="6" />
            <text x="215" y="252" fill={accent} text-anchor="middle" font-size="62" font-weight="900" style="font-family:var(--display)">₹480</text>
          </g>
          <g transform="translate(250 300)">
            <rect width="118" height="50" rx="14" fill={accent} stroke="none" />
            <path d="M24 50 l-6 16 l20 -16 z" fill={accent} stroke="none" />
            <text x="59" y="32" fill={bg} text-anchor="middle" font-size="18" font-weight="800" style="font-family:var(--display)">Bhaiya…</text>
          </g>
        </g>
      )
    }
  </g>

  <rect width="400" height="600" fill={`url(#fade-${id})`}></rect>

  <text x="24" y="38" fill={ink} fill-opacity="0.75" style="font-family:var(--mono)" font-size="10" letter-spacing="2.5">{status}</text>
  <circle cx="371" cy="34" r="5" fill={status === 'NOW SHOWING' ? '#ff4d3d' : accent}></circle>

  <text x="200" y={taglineY} fill={ink} style="font-family:var(--serif)" font-style="italic" font-size="15" text-anchor="middle" fill-opacity="0.85">
    {tagline.length > 54 ? `${tagline.slice(0, 52).replace(/\s\S*$/, '')}…` : tagline}
  </text>
  <text
    x="200"
    y={titleY}
    fill={ink}
    style="font-family:var(--display)"
    font-weight="800"
    font-size={nameSize}
    text-anchor="middle"
    letter-spacing="-3">{big}</text
  >

  <text x="200" y="540" fill={ink} fill-opacity="0.55" style="font-family:var(--display)" font-weight="600" font-size="9" text-anchor="middle" textLength="352" lengthAdjust="spacingAndGlyphs">
    {billing}
  </text>

  <g transform="translate(24 558)">
    <rect width="96" height="22" fill="none" stroke={ink} stroke-opacity="0.6"></rect>
    <text x="8" y="15" fill={ink} style="font-family:var(--display)" font-weight="800" font-size="11">RATED</text>
    <text x="52" y="15.5" fill={accent} style="font-family:var(--display)" font-weight="800" font-size="12">{platform.split(/[ ·/]/)[0].slice(0, 7).toUpperCase()}</text>
  </g>
  <text x="376" y="573" fill={ink} fill-opacity="0.5" style="font-family:var(--mono)" font-size="9" text-anchor="end" letter-spacing="1">{platform.toUpperCase()}</text>

  <rect width="400" height="600" filter={`url(#n-${id})`} opacity="0.5"></rect>
</svg>

<style>
  .poster {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8), 0 0 0 1px var(--line);
  }
</style>
