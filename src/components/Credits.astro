---
import { profile, url } from '../lib/data';

const year = new Date().getFullYear();
const links = Object.entries(profile.links);
// The end-credits roll comes from `credits:` in src/data/profile.yaml (editable in Pages CMS).
const roll = profile.credits ?? [];---

<footer class="credits" id="contact" data-reel="∞">
  <div class="wrap">
    <p class="label">End credits</p>
    <h2 class="cta">
      Let's make<br /><em>something.</em>
    </h2>
    <div class="actions">
      <a class="btn primary" href={url('/hire/')}>Hire me for freelance</a>
      <a class="btn" href={`mailto:${profile.email}`}>{profile.email}</a>
      <a class="btn" href={url(profile.resume)} download>Download résumé</a>
    </div>
    <p class="avail mono"><span class="dot"></span>{profile.availability}</p>

    <dl class="roll">
      {
        roll.map(({ role: k, name: v }) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>

    <div class="bottom">
      <ul class="social">
        {
          links.map(([k, v]) => (
            <li>
              <a href={v} target="_blank" rel="noopener me">
                {k}
              </a>
            </li>
          ))
        }
        <li><a href={url('/rss.xml')}>rss</a></li>
        <li><a href={url('/?intro')} data-replay-intro>▶ replay opening titles</a></li>
      </ul>
      <p class="mono fine">© {year} {profile.name}. No animals were harmed. Several bugs were.</p>
    </div>
  </div>
</footer>

<style>
  .credits {
    position: relative;
    z-index: 1;
    margin-top: clamp(96px, 16vw, 200px);
    padding: clamp(72px, 10vw, 120px) 0 72px;
    border-top: 1px solid var(--line);
    background: linear-gradient(to bottom, transparent, rgb(255 181 71 / 0.03));
  }
  .cta {
    font-weight: 800;
    font-size: clamp(56px, 12vw, 180px);
    line-height: 0.86;
    letter-spacing: -0.055em;
    margin: 18px 0 40px;
  }
  .cta em {
    font-family: var(--serif);
    font-weight: 400;
    color: var(--accent);
    letter-spacing: -0.02em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .avail {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 26px;
    color: var(--dim);
    font-size: 12px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 10px #4ade80;
  }
  .roll {
    margin: clamp(64px, 10vw, 120px) auto 0;
    max-width: 640px;
    display: grid;
    gap: 14px;
  }
  .roll div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .roll dt {
    text-align: right;
    font: 500 11px/1.9 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .roll dd {
    margin: 0;
    font-weight: 600;
    font-size: 15px;
  }
  .bottom {
    margin-top: 80px;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .social a {
    font: 500 12px var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--dim);
  }
  .social a:hover {
    color: var(--accent);
  }
  .fine {
    font-size: 11px;
    color: var(--faint);
    margin: 0;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  @media (max-width: 560px) {
    .roll div {
      grid-template-columns: 1fr;
      gap: 0;
      text-align: center;
    }
    .roll dt {
      text-align: center;
    }
  }
</style>
