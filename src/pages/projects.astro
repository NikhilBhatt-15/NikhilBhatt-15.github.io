---
import Base from '../layouts/Base.astro';
import { url } from '../lib/data';
import { getProjects } from '../lib/content';

const projects = await getProjects();
---

<Base title="Early works" description="Projects Nikhil Bhatt built while learning: web apps, backends, Android and games.">
  <section class="wrap">
    <header class="page-head">
      <span class="label">The archive · {projects.length} titles</span>
      <h1>Early <em>works</em></h1>
      <p>
        The student films. These are projects from the years I was learning the craft. Some are rough, some I'm proud
        of, and all of them taught me something I still use.
      </p>
    </header>

    <ol class="list">
      {
        projects.map((p, i) => (
          <li class="reveal">
            <span class="idx mono">{String(i + 1).padStart(2, '0')}</span>
            <div class="thumb">
              {p.data.image ? <img src={url(p.data.image)} alt="" loading="lazy" /> : <span class="serif">{p.data.title[0]}</span>}
            </div>
            <div class="info">
              <h2>
                {p.data.title} <span class="mono yr">{p.data.year}</span>
              </h2>
              <p>{p.data.summary}</p>
              <ul class="chips">
                {p.data.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
            <div class="go">
              {p.data.live && (
                <a href={p.data.live} target="_blank" rel="noopener">
                  Live ↗
                </a>
              )}
              {p.data.repo && (
                <a href={p.data.repo} target="_blank" rel="noopener">
                  Code ↗
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .list {
    list-style: none;
    margin: 72px 0 0;
    padding: 0;
  }
  .list li {
    display: grid;
    grid-template-columns: 40px 200px 1fr auto;
    gap: 28px;
    align-items: center;
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }
  .idx {
    font-size: 12px;
    color: var(--faint);
  }
  .thumb {
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    overflow: hidden;
    background: radial-gradient(circle at 50% 40%, rgb(255 181 71 / 0.12), var(--bg-3) 70%);
    display: grid;
    place-items: center;
    box-shadow: 0 0 0 1px var(--line);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(0.9) brightness(0.85);
    transition: filter 0.5s var(--ease);
  }
  .list li:hover .thumb img {
    filter: none;
  }
  .thumb span {
    font-size: 48px;
    color: var(--accent);
  }
  h2 {
    margin: 0;
    font-size: clamp(22px, 2.6vw, 30px);
    letter-spacing: -0.03em;
  }
  .yr {
    font-size: 11px;
    color: var(--accent);
    margin-left: 8px;
    vertical-align: middle;
  }
  .info p {
    margin: 6px 0 12px;
    color: var(--dim);
    max-width: 70ch;
  }
  .go {
    display: grid;
    gap: 8px;
    justify-items: end;
  }
  .go a {
    font: 500 12px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--dim);
  }
  .go a:hover {
    color: var(--accent);
  }
  @media (max-width: 820px) {
    .list li {
      grid-template-columns: 120px 1fr;
      gap: 16px;
      align-items: start;
    }
    .idx {
      display: none;
    }
    .go {
      grid-column: 2;
      display: flex;
      gap: 18px;
      justify-items: start;
    }
  }
  @media (max-width: 480px) {
    .list li {
      grid-template-columns: 1fr;
    }
    .go {
      grid-column: 1;
    }
  }
</style>
