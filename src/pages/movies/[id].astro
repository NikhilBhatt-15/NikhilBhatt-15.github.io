---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MoviePoster from '../../components/MoviePoster.astro';
import Stars from '../../components/Stars.astro';
import { url, fmtDate } from '../../lib/data';
import { getMovies } from '../../lib/content';

export async function getStaticPaths() {
  const all = await getMovies();
  return all.map((movie, i) => ({
    params: { id: movie.id },
    props: { movie, newer: all[i - 1], older: all[i + 1] },
  }));
}
const { movie, newer, older } = Astro.props;
const m = movie.data;
const { Content } = await render(movie);
const hasReview = Boolean(movie.body?.trim());
const bg = m.backdrop ?? m.poster;
---

<Base title={`${m.title} (${m.year})`} description={m.oneLiner ?? `Nikhil's notes on ${m.title}.`} image={m.backdrop ?? m.poster}>
  <article>
    <div class="hero">
      {bg && <img class:list={['bd', { blur: !m.backdrop }]} src={bg} alt="" referrerpolicy="no-referrer" />}
      <div class="shade"></div>
    </div>
    <div class="wrap top">
      <a class="back mono" href={url('/movies/')}>← The diary</a>
      <div class="head">
        <div class="poster">
          <MoviePoster {...m} eager />
        </div>
        <div>
          {m.pick && <span class="label pick">★ Film of the {m.pick}</span>}
          <h1>{m.title}</h1>
          <p class="meta serif">
            {m.year}
            {m.director && <> · directed by {m.director}</>}
            {m.runtime && <> · {m.runtime} min</>}
          </p>
          <div class="watched">
            <Stars rating={m.rating} liked={m.liked} rewatch={m.rewatch} size={22} />
            <span class="mono dim">
              {m.rewatch ? 'Rewatched' : 'Watched'} {fmtDate(m.watched)}
            </span>
          </div>
          {m.oneLiner && <p class="one">“{m.oneLiner}”</p>}
          {
            m.tags.length > 0 && (
              <ul class="chips">
                {m.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )
          }
        </div>
      </div>

      {
        hasReview ? (
          <div class="prose review">
            <Content />
          </div>
        ) : (
          <p class="dim noreview serif">No review this time. The stars say enough.</p>
        )
      }

      <nav class="pn" aria-label="More films">
        {
          older ? (
            <a href={url(`/movies/${older.id}/`)}>
              <span class="label">← Watched before</span>
              <span class="pn-t">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <a class="r" href={url(`/movies/${newer.id}/`)}>
              <span class="label">Watched after →</span>
              <span class="pn-t">{newer.data.title}</span>
            </a>
          )
        }
      </nav>
    </div>
  </article>
</Base>

<style>
  .hero {
    position: absolute;
    inset: 0 0 auto;
    height: min(78vh, 720px);
    overflow: hidden;
    z-index: -1;
  }
  .bd {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }
  .bd.blur {
    filter: blur(48px) saturate(1.3);
    transform: scale(1.2);
    opacity: 0.45;
  }
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(11 10 9 / 0.3), var(--bg) 92%);
  }
  .top {
    padding-top: 110px;
  }
  .back {
    font-size: 12px;
    color: var(--dim);
    text-decoration: none;
  }
  .head {
    display: grid;
    grid-template-columns: minmax(140px, 280px) 1fr;
    gap: clamp(24px, 5vw, 64px);
    align-items: end;
    margin-top: clamp(80px, 20vh, 220px);
  }
  @media (max-width: 620px) {
    .head {
      grid-template-columns: 1fr;
    }
    .poster {
      max-width: 180px;
    }
  }
  .pick {
    color: var(--accent);
  }
  h1 {
    margin: 10px 0 6px;
    font-weight: 800;
    font-size: clamp(48px, 8vw, 120px);
    line-height: 0.9;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .meta {
    font-size: 24px;
    color: var(--dim);
    margin: 0 0 20px;
  }
  .watched {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }
  .watched .mono {
    font-size: 11px;
  }
  .one {
    font-family: var(--serif);
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.25;
    margin: 24px 0;
    max-width: 36ch;
  }
  .review {
    margin: 72px auto 0;
  }
  .review :global(p:first-of-type)::first-letter {
    font-family: var(--serif);
    float: left;
    font-size: 4.2em;
    line-height: 0.8;
    padding: 6px 10px 0 0;
    color: var(--accent);
  }
  .noreview {
    font-size: 22px;
    margin-top: 72px;
    text-align: center;
  }
  .pn {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 120px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .pn a {
    display: grid;
    gap: 4px;
    text-decoration: none;
  }
  .pn .r {
    text-align: right;
  }
  .pn-t {
    font-weight: 700;
    font-size: clamp(20px, 3vw, 32px);
    letter-spacing: -0.03em;
  }
</style>
