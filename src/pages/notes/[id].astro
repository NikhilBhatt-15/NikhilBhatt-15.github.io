---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, fmtDate } from '../../lib/data';
import { getNotes } from '../../lib/content';

export async function getStaticPaths() {
  return (await getNotes()).map((note) => ({ params: { id: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content, headings } = await render(note);
const words = (note.body ?? '').split(/\s+/).length;
const mins = Math.max(1, Math.round(words / 230));
---

<Base title={note.data.title} description={note.data.summary}>
  <article class="wrap">
    <header class="head">
      <a class="back mono" href={url('/notes/')}>← Notes</a>
      <p class="label">{fmtDate(note.data.date)} · {mins} min read</p>
      <h1>{note.data.title}</h1>
      <p class="sum serif">{note.data.summary}</p>
      {
        note.data.tags.length > 0 && (
          <ul class="chips">
            {note.data.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="layout">
      <div class="prose">
        <Content />
      </div>
      {
        headings.filter((h) => h.depth === 2).length > 2 && (
          <aside class="toc">
            <p class="label">Scenes</p>
            <ol>
              {headings
                .filter((h) => h.depth === 2)
                .map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
            </ol>
          </aside>
        )
      }
    </div>
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(120px, 16vw, 180px);
    max-width: 900px;
  }
  .back {
    font-size: 12px;
    color: var(--dim);
    text-decoration: none;
  }
  .label {
    margin-top: 28px;
  }
  h1 {
    font-size: clamp(40px, 7vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.05em;
    margin: 10px 0 20px;
    text-wrap: balance;
  }
  .sum {
    font-size: clamp(22px, 2.4vw, 28px);
    color: var(--dim);
    line-height: 1.3;
    margin: 0 0 20px;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 68ch) 1fr;
    gap: 64px;
    margin-top: 64px;
  }
  .toc {
    position: sticky;
    top: 100px;
    align-self: start;
  }
  .toc ol {
    padding-left: 1.2em;
    font-size: 14px;
    color: var(--dim);
  }
  .toc a {
    text-decoration: none;
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .toc {
      display: none;
    }
  }
</style>
